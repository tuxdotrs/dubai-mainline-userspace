--- a/modules/initrd.nix
+++ b/modules/initrd.nix
@@ -57,6 +57,18 @@ let
   initWrapper = pkgs.writeScript "init-wrapper" ''
     #!${extraUtils}/bin/sh
 
+    # The kernel gives PID 1 /dev/console as stdin/out/err, but the initrd has
+    # no device nodes; unless the kernel has a built-in initramfs providing
+    # it ("unable to open an initial console"), init starts with them closed
+    # and the first write fails with EBADF.
+    ${extraUtils}/bin/mknod /.console c 5 1
+    ${extraUtils}/bin/mknod /.null c 1 3
+    if (exec 3<>/.console) 2>/.null; then
+      exec 0<>/.console 1>&0 2>&0
+    else
+      exec 0<>/.null 1>&0 2>&0
+    fi
+
     echo
     echo "***************************************"
     echo "* Mobile NixOS stage-${toString config.mobile.boot.stage-1.stage} script wrapper *"
